<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>jeecg-boot-module</artifactId>
        <groupId>org.jeecgframework.boot3</groupId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>jeecg-module-study</artifactId>
    <description>jeecg-study 学习助手业务模块（多家庭 / 多孩子 / 多家长）</description>

    <dependencies>
        <!-- 底座：Shiro+JWT 认证、MyBatis-Plus、通用工具、AOP -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-boot-base-core</artifactId>
        </dependency>
        <!-- 系统消息：ISysBaseAPI.sendSysAnnouncement 等 -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-system-local-api</artifactId>
        </dependency>
        <!--
          系统用户/角色：孩子账号复用 sys_user（角色 study_kid），家长账号复用 sys_user（角色 study_parent）。
          需要 ISysUserService.getUserByName / addUserWithRole 与 ISysRoleService。
          system-biz 不依赖本模块，无循环依赖。ADR-029。
        -->
        <dependency>
            <groupId>org.jeecgframework.boot3</groupId>
            <artifactId>jeecg-system-biz</artifactId>
        </dependency>
        <!-- R-02 的 ArchUnit 断言（判定层零 AI 依赖）需要 test 作用域依赖 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 测试骨架：JUnit5 + Mockito + Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!--
          skipTests 走 property，而不是硬编码。
          背景：上游 jeecg-boot/pom.xml 的 surefire 把 <skipTests> 硬编码为 true（打包跳过测试）；
          本模块为了让 mvn test 能跑，把 <skipTests> 也硬编码成 false。
          硬编码的写法有个真实后果：**命令行 -DskipTests=true 会被完全忽略** ⇒
          「构建时跳过测试」根本跳不掉 —— 构建会跑全部 357 条测试，
          而测试要连真实库 ⇒ 构建成败取决于机器上有没有注入数据库口令
          （实测：无口令时 dataSource 创建失败 ⇒ 227 条 error，构建假红）。
          改成 ${skipTests} 后：默认 false（mvn test 照跑，CI 不受影响），
          构建时用 -DskipTests=true 显式跳过（见 04-建库迁移/build-and-sync.ps1）。
        -->
        <skipTests>false</skipTests>
    </properties>

    <build>
        <plugins>
            <!-- The JeecgBoot parent POM skips tests globally. Keep study-module tests runnable. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipTests}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
